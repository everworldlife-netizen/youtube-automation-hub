# YouTube Automation Hub - Environment Variables

# OpenAI API Configuration (for GPT-4 and DALL-E)
OPENAI_API_KEY=your_openai_api_key_here

# Google API Configuration (for YouTube uploads)
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token

# Alternative: Google Gemini (Free Tier)
GOOGLE_API_KEY=your_google_gemini_api_key

# Alternative: OpenRouter (access any LLM)
OPENROUTER_API_KEY=your_openrouter_api_key

# Automation Settings
AI_PROVIDER=openai  # Options: openai, gemini, openrouter
AI_MODEL=  # Optional: override the default model (e.g. anthropic/claude-sonnet-4, google/gemini-2.0-flash-001)
UPLOAD_SCHEDULE=daily  # Options: daily, weekly, custom
CONTENT_TYPE=short  # Options: short (Shorts), long (Longform), mixed
AUTO_PUBLISH=false  # Options: true (publish immediately), false (manual approval)

# Video Settings
VIDEO_OUTPUT_DIR=./videos
TEMP_DIR=./temp
MAX_VIDEO_LENGTH=60  # in seconds for shorts
QUALITY_PRESET=high  # Options: low, medium, high

# Channel Configuration
PRIMARY_CHANNEL_ID=UCxxxxxxxxxxxxxxxxx
SECONDARY_CHANNELS=UC1xxx,UC2xxx,UC3xxx

# Logging
LOG_LEVEL=info  # Options: debug, info, warn, error
LOG_FILE=./logs/automation.log

# Analytics
ENABLE_ANALYTICS=true
ANALYTICS_REPORT_INTERVAL=7  # days

# Webhook (for monitoring)
WEBHOOK_URL=https://your-webhook-url.com/youtube-automation
